PORT=4000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=aiserver
DB_PASSWORD=
DB_NAME=aiserver
# Set DB_SSL=require for managed PostgreSQL (RDS/Supabase/Neon);
# DB_SSL_REJECT_UNAUTHORIZED=1 additionally enforces chain verification.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
DB_POOL_MAX=10
# Superuser used by `node src/initDb.js` to create the role/database.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_ADMIN_DB=postgres
JWT_SECRET=change-me

AI_ASSISTANT_URL=http://127.0.0.1:9001
AI_ASSISTANT_ENHANCE_URL=http://127.0.0.1:9003
AI_ASSISTANT_API_KEY=change-me-internal-key
AI_TIMEOUT=60

CHAT_LLM_PROVIDER=ollama
CHAT_OLLAMA_MODEL=llama3.2:3b
CHAT_OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_LLM_TIMEOUT_MS=45000

RECEIVER_RESULTS_DIR=/var/receiver-results
PUBLIC_SITE_URL=https://your-site.example.com
